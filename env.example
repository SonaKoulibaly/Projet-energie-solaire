# =============================================================================
# .env.example — TEMPLATE À COMMITTER sur GitHub (sans vraies valeurs)
# Auteur : Sona KOULIBALY (SK)
#
# UTILISATION :
#   cp .env.example .env      (Windows: copy .env.example .env)
#   → remplir les vraies valeurs dans .env  ← jamais commité sur GitHub
# =============================================================================

# Clé secrète Flask — générer avec :
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REMPLACER_PAR_UNE_VRAIE_CLE_SECRETE

# Mode debug : True en local, False en production
DEBUG=False

# Port local (Render gère le sien via $PORT automatiquement)
PORT=8472

# Chemin vers le dataset
DATA_PATH=data/salar_data.csv
